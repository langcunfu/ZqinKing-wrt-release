#!/bin/sh
# NSY G68 preinit hook: 清除 rootfs 分区(squashfs)尾部残留的旧 overlay ext4 超级块。
#
# 背景: overlay 使用 squashfs 尾部剩余空间(rootdisk 机制, loop0 = p2 - squashfs)。
# 若 eMMC 上该区域残留上一次刷机(分区更小/旧固件)留下的 ext4 文件系统,
# fstools 的 volume_identify 会识别为已有 FS_EXT4 并直接复用, 导致 overlay
# 只有旧文件系统那么大(如 36.8M), 而不是整个尾部(1.8G)。
#
# 本脚本在 mount_root(80_mount_root)之前运行:
#   检测到 p2 尾部有 ext4 残留(超级块 magic 0xEF53) -> 清零超级块区域,
#   mount_root 随后识别为 FS_NONE, 自动 mkfs 完整大小的 overlay。
#
# squashfs 超级块布局(小端): s_magic@0(4B), pad[9]@4(36B), bytes_used@40(8B)
# ext4 超级块: magic 0xEF53 @ (rootfs_data 起始偏移 + 0x438)

boot_hook_add preinit_main nsy_fix_overlay

nsy_fix_overlay() {
	local dev="/dev/mmcblk0p2"
	local bu magic

	[ -b "$dev" ] || return 0

	# 读取 squashfs bytes_used(数据实际大小, 字节)
	bu=$(dd if="$dev" bs=1 skip=40 count=8 2>/dev/null | od -An -t u8 | tr -d ' \n')
	[ -n "$bu" ] && [ "$bu" -gt 1048576 ] 2>/dev/null || return 0

	# 检测 rootfs_data 区域起始处是否有旧 ext4 超级块(0xEF53 小端 => 53 ef)
	magic=$(dd if="$dev" bs=1 skip=$((bu + 0x438)) count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')
	[ "$magic" = "53ef" ] || return 0

	echo "NSY: 清除 rootfs 尾部旧 overlay ext4 残留 (offset $((bu / 1024)) KiB)"
	dd if=/dev/zero of="$dev" bs=1024 seek=$((bu / 1024)) count=4096 conv=notrunc 2>/dev/null
}
